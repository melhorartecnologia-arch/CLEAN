# Copie este arquivo para ".env" e ajuste os valores. Todas as opções são opcionais.

# Porta HTTP do servidor web
PORT=3000

# Endereço de escuta. 127.0.0.1 = acessível apenas neste computador.
# Use 0.0.0.0 para permitir acesso pela rede (defina também usuário e senha abaixo).
HOST=127.0.0.1

# Outros nomes pelos quais o CLEAN será acessado, separados por vírgula (ex.: um apelido DNS ou o
# endereço publicado por um proxy). localhost, o nome e os IPs desta máquina já são aceitos.
ALLOWED_HOSTS=

# Usuário e senha para acessar a interface (autenticação HTTP básica).
# Recomendado sempre que HOST não for 127.0.0.1.
AUTH_USER=
AUTH_PASSWORD=

# Pasta onde ficam a configuração e os relatórios (padrão: ./data)
DATA_DIR=data

# Quantas análises podem rodar ao mesmo tempo (as demais aguardam na fila)
MAX_CONCURRENT_SCANS=1

# Caminho do PowerShell (padrão: powershell.exe no Windows)
# POWERSHELL_PATH=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
